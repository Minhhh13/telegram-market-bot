# Configure these as private environment variables in the cloud host.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: the numeric Telegram forum topic ID. Leave empty for the main chat.
TELEGRAM_THREAD_ID=
QUOTE_AMOUNT_VND=20000000
# Optional channel-scoped Discord webhooks. A configured feed sends only to
# Discord; omit its webhook to retain Telegram delivery. Never commit real URLs.
P2P_DISCORD_WEBHOOK_URL=
MARKETCAP_DISCORD_WEBHOOK_URL=
